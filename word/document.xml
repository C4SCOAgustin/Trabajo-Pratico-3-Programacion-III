<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh wp14"><w:body><w:p w14:paraId="533544C4" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:pPr><w:spacing w:after="80"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr><w:t>Trabajo Práctico 3: El equipo ideal</w:t></w:r></w:p><w:p w14:paraId="3D9BEC12" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:pPr><w:spacing w:after="240"/><w:jc w:val="center"/></w:pPr><w:r><w:t>Programación III — Documento de implementación</w:t></w:r></w:p><w:p w14:paraId="21BC325A" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:pPr><w:pStyle w:val="Ttulo1"/></w:pPr><w:r><w:t>1. Descripción general</w:t></w:r></w:p><w:p w14:paraId="4BE468EE" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:r><w:t>La aplicación resuelve el problema de armar un equipo de desarrollo a partir de una lista de personas (cada una con un rol y una calificación de 1 a 5), una lista de pares de personas incompatibles y un conjunto de requerimientos que indica cuántas persona</w:t></w:r><w:r><w:t>s se necesitan por cada rol. El objetivo es encontrar el equipo válido (que cumple exactamente los requerimientos y no contiene ningún par incompatible) cuya suma de calificaciones sea máxima.</w:t></w:r></w:p><w:p w14:paraId="149A622F" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:pPr><w:pStyle w:val="Ttulo1"/></w:pPr><w:r><w:t>2. Arquitectura (MVT)</w:t></w:r></w:p><w:p w14:paraId="01B551E3" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:r><w:t>El proyecto se organiza en tres capas cla</w:t></w:r><w:r><w:t>ramente separadas en paquetes distintos:</w:t></w:r></w:p><w:p w14:paraId="24131668" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:pPr><w:pStyle w:val="Prrafodelista"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Modelo (paquete modelo): </w:t></w:r><w:r><w:t xml:space="preserve">contiene las clases de dominio y toda la lógica de negocio. Aquí están Persona, Rol, Incompatibilidad, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>GestorIncompatibilidades</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">, Requerimientos, Equipo y el algoritmo en la clase </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Solver</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">. No </w:t></w:r><w:r><w:t>conoce nada de la interfaz gráfica.</w:t></w:r></w:p><w:p w14:paraId="0B4F5C51" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:pPr><w:pStyle w:val="Prrafodelista"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Vista (</w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>paquete vista</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">): </w:t></w:r><w:r><w:t>contiene la interfaz gráfica Swing (</w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>VentanaPrincipal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">) y el punto de entrada </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Main</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>. Solo se ocupa de mostrar datos y capturar eventos del usuario; no contiene lógica del problema.</w:t></w:r></w:p><w:p w14:paraId="7E95534F" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:pPr><w:pStyle w:val="Prrafodelista"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Template</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>/Controlado</w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">r (paquete controlador): </w:t></w:r><w:r><w:t>la clase Controlador conecta la vista con el modelo. Mantiene el estado (lista de personas, incompatibilidades y requerimientos), valida las operaciones que pide la vista y lanza el algoritmo. Es la única capa que ambos lados conoc</w:t></w:r><w:r><w:t>en.</w:t></w:r></w:p><w:p w14:paraId="41A9ED45" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:r><w:t xml:space="preserve">De esta forma la vista nunca instancia directamente el </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Solver</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> ni manipula las reglas del problema: todo pasa por el controlador, y la lógica vive íntegramente en el modelo.</w:t></w:r></w:p><w:p w14:paraId="2F003560" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:pPr><w:pStyle w:val="Ttulo1"/></w:pPr><w:r><w:t>3. El algoritmo (</w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>backtracking</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>)</w:t></w:r></w:p><w:p w14:paraId="360C7E64" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:r><w:t xml:space="preserve">El </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Solver</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> recorre la lista de personas tomando, </w:t></w:r><w:r><w:t xml:space="preserve">para cada una, dos decisiones: incluirla en el equipo o no incluirla. Esto genera el árbol de combinaciones propio del </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>backtracking</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>.</w:t></w:r></w:p><w:p w14:paraId="185985FE" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:r><w:t>Antes de incluir a una persona se verifican dos condiciones: que todavía haya cupo en su rol según los requerimientos, y qu</w:t></w:r><w:r><w:t>e no sea incompatible con ninguno de los ya seleccionados. Si alguna falla, esa rama no se explora (poda). Cuando se llega al final de la lista (caso base), se comprueba que el equipo cumpla exactamente la cantidad pedida en cada rol; si la cumple y su pun</w:t></w:r><w:r><w:t>taje supera al mejor encontrado hasta el momento, se guarda como nueva mejor solución.</w:t></w:r></w:p><w:p w14:paraId="3D761593" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:r><w:t xml:space="preserve">Al terminar, el </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Solver</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> devuelve el equipo de mayor puntaje. Si no existe ninguna combinación válida, devuelve un equipo vacío. La clase también lleva un contador de cuán</w:t></w:r><w:r><w:t>tas veces se ejecutó el caso base, útil como estadística del algoritmo.</w:t></w:r></w:p><w:p w14:paraId="762679FF" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:pPr><w:pStyle w:val="Ttulo1"/></w:pPr><w:r><w:t>4. Ejecución en un hilo separado</w:t></w:r></w:p><w:p w14:paraId="3D23246C" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:r><w:t xml:space="preserve">Como el </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>backtracking</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> puede demorar, no debe ejecutarse en el hilo de eventos de Swing (EDT) porque congelaría la ventana. Por eso el método </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>resolverAsy</w:t></w:r><w:r><w:t>nc</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> del Controlador usa un </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>SwingWorker</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">: el cálculo se hace en </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>doInBackground</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> (hilo aparte) y, cuando termina, el resultado se entrega a la vista en done, que sí corre en el EDT y puede actualizar la interfaz con seguridad. Mientras tanto el botón Resolver s</w:t></w:r><w:r><w:t>e deshabilita y se muestra el mensaje «Resolviendo...», de modo que la UI permanece fluida.</w:t></w:r></w:p><w:p w14:paraId="08391596" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:pPr><w:pStyle w:val="Ttulo1"/></w:pPr><w:r><w:t>5. Interfaz gráfica</w:t></w:r></w:p><w:p w14:paraId="10FDC083" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:r><w:lastRenderedPageBreak/><w:t xml:space="preserve">La ventana usa un </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>JTabbedPane</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> con cuatro solapas: Personas (alta y listado), Incompatibilidades (selección de dos personas mediante combos y lis</w:t></w:r><w:r><w:t xml:space="preserve">tado), Requerimientos (un </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>spinner</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> por cada rol) y Resultado (botón Resolver y área de texto con el equipo obtenido y su puntaje). Está construida con componentes estándar de Swing compatibles con </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>WindowBuilder</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>.</w:t></w:r></w:p><w:p w14:paraId="2EB38F50" w14:textId="2E4FF7AF" w:rsidR="000E5FF4" w:rsidRDefault="00B262B7"><w:pPr><w:pStyle w:val="Ttulo1"/></w:pPr><w:r><w:t>6</w:t></w:r><w:r w:rsidR="00FE1F1C"><w:t>. Decisiones de diseño</w:t></w:r></w:p><w:p w14:paraId="398DB0F3" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:pPr><w:pStyle w:val="Prrafodelista"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Se usó un </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>enum</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> Rol para evitar errores por </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>strings</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> sueltos y dar claridad </w:t></w:r><w:r><w:t>al dominio.</w:t></w:r></w:p><w:p w14:paraId="0BCA3FA9" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:pPr><w:pStyle w:val="Prrafodelista"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t>Persona valida sus datos en el constructor (nombre no vacío, calificación entre 1 y 5) y se identifica por nombre, lo que simplifica comparaciones e incompatibilidades.</w:t></w:r></w:p><w:p w14:paraId="68F8E0A7" w14:textId="77777777" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:pPr><w:pStyle w:val="Prrafodelista"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Se priorizó una solución simple y correcta sobre optimizaciones avanzadas, </w:t></w:r><w:r><w:t>manteniendo la separación estricta de capas como requisito central.</w:t></w:r></w:p><w:p w14:paraId="6279EF69" w14:textId="6F9B9FD9" w:rsidR="000E5FF4" w:rsidRDefault="00B262B7"><w:pPr><w:pStyle w:val="Ttulo1"/></w:pPr><w:r><w:t>8</w:t></w:r><w:r w:rsidR="00FE1F1C"><w:t>. Cómo ejecutar</w:t></w:r></w:p><w:p w14:paraId="7AE27C03" w14:textId="1A3970E8" w:rsidR="000E5FF4" w:rsidRDefault="00FE1F1C"><w:r><w:t xml:space="preserve">Importar el proyecto en Eclipse (File &gt; </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Import</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> &gt; </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Existing</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Projects</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>into</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Workspace</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">). Ejecutar la clase </w:t></w:r><w:proofErr w:type="spellStart"/><w:proofErr w:type="gramStart"/><w:r><w:t>vis</w:t></w:r><w:r><w:t>ta.Main</w:t></w:r><w:proofErr w:type="spellEnd"/><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve"> para abrir la aplicación. </w:t></w:r></w:p><w:sectPr w:rsidR="000E5FF4"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="708" w:footer="708" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>